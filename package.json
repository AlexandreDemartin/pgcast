{
  "name": "pgcast",
  "version": "6.6.1",
  "description": "Zero-abstraction Postgres for TypeScript: types cast from your database schema. A maintained fork of Zapatos.",
  "homepage": "https://github.com/AlexandreDemartin/pgcast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreDemartin/pgcast.git"
  },
  "bugs": {
    "url": "https://github.com/AlexandreDemartin/pgcast/issues"
  },
  "bin": {
    "pgcast": "dist/generate/cli.js",
    "zapatos": "dist/generate/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npx tsc && npx gen-esm-wrapper db db.mjs && npx gen-esm-wrapper generate generate.mjs",
    "lint": "eslint src/db/*.ts src/generate/*.ts",
    "version": "npm run lint && npm run build"
  },
  "files": [
    "dist/db",
    "db.js",
    "db.d.ts",
    "db.mjs",
    "dist/generate",
    "generate.js",
    "generate.d.ts",
    "generate.mjs"
  ],
  "exports": {
    "./db": {
      "types": "./db.d.ts",
      "require": "./db.js",
      "import": "./db.mjs"
    },
    "./generate": {
      "types": "./generate.d.ts",
      "require": "./generate.js",
      "import": "./generate.mjs"
    }
  },
  "keywords": [
    "postgres",
    "postgresql",
    "typescript",
    "sql",
    "codegen",
    "zapatos"
  ],
  "author": "George MacKerron",
  "contributors": [
    "Alexandre Demartin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@types/pg": ">=7.14.3",
    "pg": ">=7.18.2",
    "typescript": ">=4.1"
  },
  "overrides": {
    "eslint": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.5.0",
    "@types/pg": "^8.6.5",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.26.0",
    "gen-esm-wrapper": "^1.1.3",
    "globals": "^15.6.0",
    "pg": "^8.7.3",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "json-custom-numbers": "^3.1.1"
  }
}
