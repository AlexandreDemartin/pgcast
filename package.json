{
  "name": "pgcast",
  "version": "6.6.1",
  "description": "Zero-abstraction Postgres for TypeScript: types cast from your database schema. A maintained fork of Zapatos.",
  "homepage": "https://github.com/AlexandreDemartin/pgcast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreDemartin/pgcast.git"
  },
  "bugs": {
    "url": "https://github.com/AlexandreDemartin/pgcast/issues"
  },
  "bin": {
    "pgcast": "dist/generate/cli.js",
    "zapatos": "dist/generate/cli.js"
  },
  "scripts": {
    "build": "tsc && gen-esm-wrapper db db.mjs && gen-esm-wrapper generate generate.mjs",
    "prepack": "npm run build",
    "lint": "eslint src/db/*.ts src/generate/*.ts",
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.only",
    "bench:types": "node -e \"console.error('bench:types arrive en phase 1 (cf. docs/ROADMAP.md)'); process.exit(1)\"",
    "version": "npm run lint && npm run typecheck && npm test && npm run test:types && npm run build",
    "check:agents": "node scripts/check-agents.mjs"
  },
  "files": [
    "dist/db",
    "db.js",
    "db.d.ts",
    "db.mjs",
    "dist/generate",
    "generate.js",
    "generate.d.ts",
    "generate.mjs"
  ],
  "exports": {
    "./db": {
      "types": "./db.d.ts",
      "require": "./db.js",
      "import": "./db.mjs"
    },
    "./generate": {
      "types": "./generate.d.ts",
      "require": "./generate.js",
      "import": "./generate.mjs"
    }
  },
  "keywords": [
    "postgres",
    "postgresql",
    "typescript",
    "sql",
    "codegen",
    "zapatos"
  ],
  "author": "George MacKerron",
  "contributors": [
    "Alexandre Demartin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@types/pg": ">=7.14.3",
    "pg": ">=7.18.2",
    "typescript": ">=4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "expect-type": "^1.4.0",
    "gen-esm-wrapper": "^1.1.3",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "json-custom-numbers": "^3.1.1"
  }
}
