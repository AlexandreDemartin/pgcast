{
  // The package's build: CommonJS, ES2019 and the strict options of the core (../../tsconfig.json).
  // No Node typings: src/ runs in a page too, so a Node built-in (Buffer, util) does not compile there.
  // TypeScript comes from the repository root's install (README § Development).
  "include": ["src/**/*"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2019",
    "lib": ["ES2019", "DOM"],
    "module": "CommonJS",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "noUnusedLocals": true,
    "types": []
  }
}
