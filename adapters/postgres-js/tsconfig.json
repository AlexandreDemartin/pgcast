{
  // The package's build: CommonJS, ES2019 and the strict options of the core (../../tsconfig.json).
  // TypeScript and @types/node come from the repository root's install (README § Development).
  "include": ["src/**/*"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2019",
    "module": "CommonJS",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "noUnusedLocals": true,
    "types": ["node"]
  }
}
