{
  "name": "@pgcast/adapter-postgres-js",
  "version": "0.1.0",
  "description": "Run pgcast's queries and transactions on a postgres.js sql, with values read and written as pg reads and writes them.",
  "license": "MIT",
  "author": "Alexandre Demartin (https://github.com/AlexandreDemartin)",
  "homepage": "https://github.com/AlexandreDemartin/pgcast/tree/master/adapters/postgres-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreDemartin/pgcast.git",
    "directory": "adapters/postgres-js"
  },
  "bugs": {
    "url": "https://github.com/AlexandreDemartin/pgcast/issues"
  },
  "keywords": [
    "pgcast",
    "zapatos",
    "postgres",
    "postgres.js",
    "postgresql"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:types": "tsc -p test"
  },
  "dependencies": {
    "pg-types": "^2.2.0"
  },
  "peerDependencies": {
    "postgres": "^3.4.0 || ^4.0.0"
  },
  "devDependencies": {
    "postgres": "3.4.9"
  }
}
