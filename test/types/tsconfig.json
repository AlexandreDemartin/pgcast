{
  // Type tests (`npm run test:types`), compiled as a consumer project compiles: against the
  // fixture's generated schema (../generated/zapatos, ambient 'zapatos/schema' and 'zapatos/custom')
  // and the declarations of src/db and src/generate that `npm run test:types` emits first ('zapatos/db',
  // 'zapatos/generate', and 'zapatos/dist/db/utils' and 'zapatos/dist/generate/tables', inner modules as the package
  // holds them: ./utils.test-d.ts, ./generateTables.test-d.ts).
  "extends": "../generated/tsconfig.json",
  "include": ["../generated/zapatos/**/*", "./**/*"],
  // ./custom/PgPreferences.d.ts narrows it, as a consumer project does
  "exclude": ["../generated/zapatos/custom/PgPreferences.d.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "zapatos/db": ["../../node_modules/.cache/pgcast/db"],
      "zapatos/generate": ["../../node_modules/.cache/pgcast/generate"],
      "zapatos/dist/db/utils": ["../../node_modules/.cache/pgcast/db/utils"],
      "zapatos/dist/generate/tables": ["../../node_modules/.cache/pgcast/generate/tables"]
    }
  }
}
