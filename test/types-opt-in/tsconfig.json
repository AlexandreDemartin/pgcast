{
  // Type tests of an option declared in ConfigTypes (`npm run test:types`, with tsc): a program of its
  // own, since the declaration merges into every file of a program, and test/types holds the types
  // of an unconfigured project. Otherwise as ../types/tsconfig.json, but it emits
  // declarations, as a library built with `declaration: true` does (declarations.ts, updateValues.ts), and
  // maps 'zapatos/generate' too, to the declarations of src/generate that `npm run test:types` emits first.
  "extends": "../generated/tsconfig.json",
  "include": ["../generated/zapatos/**/*", "./**/*"],
  "exclude": ["./legacy"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/pgcast-types-opt-in",
    "paths": {
      "zapatos/db": ["../../node_modules/.cache/pgcast/db"],
      "zapatos/generate": ["../../node_modules/.cache/pgcast/generate"]
    }
  }
}
