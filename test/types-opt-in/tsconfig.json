{
  // A library's exports compiled as a library built with `declaration: true` compiles them (`npm run test:types`,
  // with tsc): as ../types/tsconfig.json, but it emits declarations (declarations.ts, updateValues.ts), so each
  // type they return must have a name a .d.ts can write, and maps 'zapatos/generate' too, to the declarations of
  // src/generate that `npm run test:types` emits first.
  "extends": "../generated/tsconfig.json",
  "include": ["../generated/zapatos/**/*", "./**/*"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/pgcast-types-opt-in",
    "paths": {
      "zapatos/db": ["../../node_modules/.cache/pgcast/db"],
      "zapatos/generate": ["../../node_modules/.cache/pgcast/generate"]
    }
  }
}
