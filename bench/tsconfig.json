{
  // Type-checking cost of a schema-heavy consumer project, measured by `npm run bench:types`
  // (scripts/bench-types.mjs). Same setup as ../test/generated/tsconfig.json: the fixture's
  // generated schema, and 'zapatos/db' as the declarations of src/db, never its sources.
  "extends": "../tsconfig.json",
  "include": ["./**/*.ts", "../test/generated/zapatos/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "zapatos/db": ["node_modules/.cache/pgcast/db"]
    }
  }
}
